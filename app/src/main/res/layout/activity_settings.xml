<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A1A">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#11112A">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← Back"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="#1B1B3A"
            android:textColor="#FF9A44"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF6A00"
            android:gravity="center"
            android:layout_marginEnd="48dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Alarm Enable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#111128"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alarm Sound"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#E4E4F0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play alarm when notification detected"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAlarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF6A00"
                    android:trackTint="#333333" />
            </LinearLayout>

            <!-- Alarm Sound Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111128"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALARM TONE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF9A44"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvAlarmName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Default (System Alarm / Police Siren)"
                    android:textSize="14sp"
                    android:textColor="#E4E4F0"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnPickAlarm"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Choose Sound"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#FF6A00"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnDefault"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Reset Default"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#1B3A4B"
                        android:textColor="#FF9A44" />
                </LinearLayout>
            </LinearLayout>

            <!-- Duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111128"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALARM DURATION"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF9A44"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 seconds"
                    android:textSize="14sp"
                    android:textColor="#E4E4F0"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/seekDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:min="1"
                    android:max="10"
                    android:progress="3"
                    android:progressTint="#FF6A00"
                    android:thumbTint="#FF6A00"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1s"
                        android:textSize="10sp"
                        android:textColor="#555555" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10s"
                        android:textSize="10sp"
                        android:textColor="#555555"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
